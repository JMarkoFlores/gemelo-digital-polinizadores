FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-scientific.txt .
RUN pip install --no-cache-dir --default-timeout=1000 --retries 10 -r requirements-scientific.txt

COPY . /app

ENV PYTHONPATH=/app:/app/backend:/app/streamlit_app

CMD ["python", "cli.py", "--help"]
