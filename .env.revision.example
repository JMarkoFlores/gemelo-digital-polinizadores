# ==============================================================================
# Variables de entorno para el entorno aislado de REVISIÓN METODOLÓGICA
# ==============================================================================
# Uso: Copiar este archivo a .env o cargar explícitamente con docker compose:
# docker compose --project-name polinizadores_revision --env-file .env.revision config
# ==============================================================================

# Nombre del proyecto para aislar contenedores, redes y volúmenes
COMPOSE_PROJECT_NAME=polinizadores_revision

# Puertos asignados para evitar colisiones con el entorno histórico o de producción
DB_PORT=5433
BACKEND_PORT=8001
FRONTEND_PORT=5174
STREAMLIT_PORT=8502
LANGFLOW_PORT=7861

# Base de datos aislada (cambiar credenciales en despliegue)
POSTGRES_DB=gemelos_db_rev
POSTGRES_USER=gemelos_user_rev
POSTGRES_PASSWORD=tu_password_seguro_aqui
DATABASE_URL=postgresql+psycopg2://gemelos_user_rev:tu_password_seguro_aqui@db:5432/gemelos_db_rev

# Seguridad y Autenticación para desarrollo local (generar claves seguras)
JWT_SECRET=tu_jwt_secret_aleatorio_minimo_32_caracteres_aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin_rev@example.com
ADMIN_PASSWORD=TuPasswordAdminSeguro123!
CLIENT_EMAIL=cliente_rev@example.com
CLIENT_PASSWORD=TuPasswordClienteSeguro123!

# CORS y API URLs coordinadas
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
VITE_API_BASE_URL=http://localhost:8001

# LLM / Langflow opcional
GROQ_API_KEY=tu_api_key_de_groq_aqui
LANGFLOW_URL=http://langflow:7860
LANGFLOW_FLOW_ID=asistente-recomendaciones-agroecologicas
